# apps/web — local development environment

# Public — exposed to the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3031
NEXT_PUBLIC_SITE_NAME="School Management"
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Optional dev bypass — when set to "1" in non-production, bypasses all sidebar & palette role/menu filtering
NEXT_PUBLIC_NAV_BYPASS=0

# Server-only — must match apps/api/.env JWT_SECRET so the dashboard
# layout can verify the cookie's HMAC signature locally. Never prefix
# with NEXT_PUBLIC_ (would leak the secret to the client bundle).
JWT_SECRET=
