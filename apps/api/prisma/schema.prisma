generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model AcademicSubjects {
  id                    String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  subjectCode           String                  @map("subject_code") @db.VarChar(30)
  subjectName           String                  @map("subject_name") @db.VarChar(150)
  boardStream           String                  @default("GENERAL") @map("board_stream") @db.VarChar(30)
  paperNumber           Int?                    @map("paper_number")
  classSyllabusSubjects ClassSyllabusSubjects[]

  @@index([subjectCode], map: "IDX_SUBJECTS_CODE")
  @@map("academic_subjects")
}

model AcademicSessions {
  id          String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  sessionName String   @map("session_name") @db.VarChar(50)
  sessionCode String   @unique(map: "uq_academic_sessions_code") @map("session_code") @db.VarChar(20)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive], map: "IDX_ACADEMIC_SESSIONS_ACTIVE")
  @@map("academic_sessions")
}

model ClassOrDepts {
  id           String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name         String   @db.VarChar(100)
  code         String   @unique(map: "uq_class_or_depts_code") @db.VarChar(20)
  level        String   @default("SCHOOL") @db.VarChar(20)
  displayOrder Int      @default(1) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive], map: "IDX_CLASS_OR_DEPTS_ACTIVE")
  @@index([level], map: "IDX_CLASS_OR_DEPTS_LEVEL")
  @@map("class_or_depts")
}

model ExamTermTypes {
  id              String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name            String   @db.VarChar(100)
  code            String   @unique(map: "uq_exam_term_types_code") @db.VarChar(30)
  engineBehavior  String   @map("engine_behavior") @db.VarChar(30)
  description     String?  @db.VarChar(255)
  displayOrder    Int      @default(1) @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive], map: "IDX_EXAM_TERM_TYPES_ACTIVE")
  @@index([engineBehavior], map: "IDX_EXAM_TERM_TYPES_BEHAVIOR")
  @@map("exam_term_types")
}

model SectionOrBatches {
  id           String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name         String   @db.VarChar(100)
  code         String   @unique(map: "uq_section_or_batches_code") @map("section_code") @db.VarChar(20)
  description  String?  @map("description") @db.VarChar(255)
  displayOrder Int      @default(1) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive], map: "IDX_SECTION_OR_BATCHES_ACTIVE")
  @@map("section_or_batches")
}

model AcademicGroups {
  id           String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name         String   @db.VarChar(100)
  code         String   @unique(map: "uq_academic_groups_code") @map("group_code") @db.VarChar(20)
  description  String?  @map("description") @db.VarChar(255)
  displayOrder Int      @default(1) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive], map: "IDX_ACADEMIC_GROUPS_ACTIVE")
  @@map("academic_groups")
}

model AccountingAuditLogs {
  id              String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  eventType       String   @map("event_type") @db.VarChar(50)
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        String   @map("entity_id") @db.Char(36)
  entityReference String?  @map("entity_reference") @db.VarChar(100)
  actorId         String?  @map("actor_id") @db.Char(36)
  action          String   @db.VarChar(50)
  details         String?  @db.Text
  ipAddress       String?  @map("ip_address") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  users           Users?   @relation(fields: [actorId], references: [id], onUpdate: Restrict, map: "FK_5cc7ad3d4322ee077af303a416c")

  @@index([actorId], map: "IDX_AUDIT_LOG_ACTOR")
  @@index([createdAt], map: "IDX_AUDIT_LOG_CREATED_AT")
  @@index([entityType, entityId], map: "IDX_AUDIT_LOG_ENTITY")
  @@index([eventType], map: "IDX_AUDIT_LOG_EVENT_TYPE")
  @@map("accounting_audit_logs")
}

model AdjunctHonorariumBills {
  id              String          @id @default(dbgenerated("(uuid())")) @db.Char(36)
  billNo          String          @unique(map: "UQ_7e2c431b23b598fa0d960c4f619") @map("bill_no") @db.VarChar(30)
  adjunctName     String          @map("adjunct_name") @db.VarChar(150)
  adjunctId       String?         @map("adjunct_id") @db.Char(36)
  workMonth       String          @map("work_month") @db.VarChar(7)
  classesCount    Int             @default(0) @map("classes_count")
  scriptsCount    Int             @default(0) @map("scripts_count")
  vivaCount       Int             @default(0) @map("viva_count")
  ratePerClass    Decimal         @default(0.00) @map("rate_per_class") @db.Decimal(15, 2)
  ratePerScript   Decimal         @default(0.00) @map("rate_per_script") @db.Decimal(15, 2)
  ratePerViva     Decimal         @default(0.00) @map("rate_per_viva") @db.Decimal(15, 2)
  grossAmount     Decimal         @default(0.00) @map("gross_amount") @db.Decimal(15, 2)
  tdsRate         Decimal         @map("tds_rate") @db.Decimal(5, 2)
  tdsAmount       Decimal         @default(0.00) @map("tds_amount") @db.Decimal(15, 2)
  netPayable      Decimal         @default(0.00) @map("net_payable") @db.Decimal(15, 2)
  fundId          String          @map("fund_id") @db.Char(36)
  costCenterId    String?         @map("cost_center_id") @db.Char(36)
  status          String          @default("DRAFT") @db.VarChar(20)
  glJournalId     String?         @map("gl_journal_id") @db.Char(36)
  narration       String?         @db.VarChar(255)
  createdByUserId String?         @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  journalEntries  JournalEntries? @relation(fields: [glJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_4f289bec631bfba5cd9c4049b2e")
  users           Users?          @relation(fields: [createdByUserId], references: [id], onUpdate: Restrict, map: "FK_7f39a395e294512630a28f76aef")
  costCenters     CostCenters?    @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_ce9decd83d40698cd87796eb5ae")
  funds           Funds           @relation(fields: [fundId], references: [id], onUpdate: Restrict, map: "FK_f4a75afd9e3f9a1b79e3da340e3")

  @@index([glJournalId], map: "FK_4f289bec631bfba5cd9c4049b2e")
  @@index([createdByUserId], map: "FK_7f39a395e294512630a28f76aef")
  @@index([costCenterId], map: "FK_ce9decd83d40698cd87796eb5ae")
  @@index([fundId], map: "FK_f4a75afd9e3f9a1b79e3da340e3")
  @@index([workMonth], map: "IDX_HONORARIUM_MONTH")
  @@map("adjunct_honorarium_bills")
}

model AdmissionApplications {
  id                 String             @id @default(dbgenerated("(uuid())")) @db.Char(36)
  applicationNo      String             @unique(map: "UQ_ef98819df5645c1238978424af4") @map("application_no") @db.VarChar(30)
  campaignId         String             @map("campaign_id") @db.Char(36)
  applicantNameEn    String             @map("applicant_name_en") @db.VarChar(120)
  applicantNameBn    String?            @map("applicant_name_bn") @db.VarChar(120)
  gender             String             @db.VarChar(15)
  dateOfBirth        DateTime           @map("date_of_birth") @db.Date
  birthRegNo         String?            @map("birth_reg_no") @db.VarChar(25)
  guardianPhone      String             @map("guardian_phone") @db.VarChar(20)
  prevExamName       String?            @map("prev_exam_name") @db.VarChar(30)
  prevBoard          String?            @map("prev_board") @db.VarChar(30)
  prevRollNo         String?            @map("prev_roll_no") @db.VarChar(30)
  prevRegNo          String?            @map("prev_reg_no") @db.VarChar(30)
  prevPassingYear    Int?               @map("prev_passing_year")
  prevGpa            Decimal?           @map("prev_gpa") @db.Decimal(4, 2)
  admissionTestMarks Decimal            @default(0.00) @map("admission_test_marks") @db.Decimal(6, 2)
  meritRank          Int?               @map("merit_rank")
  quotaApplied       String?            @map("quota_applied") @db.VarChar(40)
  formFeePaid        Boolean            @default(false) @map("form_fee_paid")
  status             String             @default("APPLIED") @db.VarChar(25)
  admittedStudentId  String?            @map("admitted_student_id") @db.Char(36)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  admissionCampaigns AdmissionCampaigns @relation(fields: [campaignId], references: [id], onUpdate: Restrict, map: "FK_4c7f324b23124b4609841a16cae")
  students           Students?          @relation(fields: [admittedStudentId], references: [id], onUpdate: Restrict, map: "FK_ebba2cd78268c80e1d1b4f6d959")

  @@index([admittedStudentId], map: "FK_ebba2cd78268c80e1d1b4f6d959")
  @@index([campaignId], map: "IDX_APPLICATIONS_CAMPAIGN")
  @@index([campaignId, meritRank], map: "IDX_APPLICATIONS_MERIT")
  @@index([guardianPhone], map: "IDX_APPLICATIONS_PHONE")
  @@index([status], map: "IDX_APPLICATIONS_STATUS")
  @@map("admission_applications")
}

model AdmissionCampaigns {
  id                    String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  academicSessionId     String                  @map("academic_session_id") @db.Char(36)
  classOrDeptId         String                  @map("class_or_dept_id") @db.Char(36)
  campaignTitle         String                  @map("campaign_title") @db.VarChar(150)
  applicationFee        Decimal                 @default(0.00) @map("application_fee") @db.Decimal(10, 2)
  totalSeats            Int                     @map("total_seats")
  minRequiredGpa        Decimal                 @default(0.00) @map("min_required_gpa") @db.Decimal(4, 2)
  startDate             DateTime                @map("start_date") @db.Date
  endDate               DateTime                @map("end_date") @db.Date
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  admissionApplications AdmissionApplications[]

  @@index([isActive], map: "IDX_CAMPAIGNS_ACTIVE")
  @@index([academicSessionId, classOrDeptId], map: "IDX_CAMPAIGNS_SESSION_CLASS")
  @@map("admission_campaigns")
}

model AdmissionSequences {
  scopeKey   String @id @map("scope_key") @db.VarChar(160)
  lastNumber Int    @default(0) @map("last_number")

  @@map("admission_sequences")
}

model AttendanceMarkSlabs {
  id               String  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name             String  @db.VarChar(100)
  minAttendancePct Decimal @map("min_attendance_pct") @db.Decimal(5, 2)
  maxAttendancePct Decimal @map("max_attendance_pct") @db.Decimal(5, 2)
  awardedMarks     Decimal @map("awarded_marks") @db.Decimal(5, 2)

  @@index([minAttendancePct], map: "IDX_ATT_SLAB_MIN")
  @@map("attendance_mark_slabs")
}

model ChartOfAccounts {
  id                     String                   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  glCode                 String                   @unique(map: "UQ_6bb8e35e8b83eeaa49218ac45cc") @map("gl_code") @db.VarChar(20)
  accountName            String                   @map("account_name") @db.VarChar(150)
  accountNameBn          String?                  @map("account_name_bn") @db.VarChar(150)
  accountType            String                   @map("account_type") @db.VarChar(20)
  normalBalance          String                   @map("normal_balance") @db.Char(2)
  parentId               String?                  @map("parent_id") @db.Char(36)
  isControlAccount       Boolean                  @default(false) @map("is_control_account")
  isCashOrBank           Boolean                  @default(false) @map("is_cash_or_bank")
  defaultFundId          String?                  @map("default_fund_id") @db.Char(36)
