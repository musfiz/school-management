model ClassSyllabusSubjects {
  id                        String                      @id @default(dbgenerated("(uuid())")) @db.Char(36)
  academicSessionId         String                      @map("academic_session_id") @db.Char(36)
  classOrDeptId             String                      @map("class_or_dept_id") @db.Char(36)
  subjectId                 String                      @map("subject_id") @db.Char(36)
  combinedGroupCode         String?                     @map("combined_group_code") @db.VarChar(40)
  combinedGroupName         String?                     @map("combined_group_name") @db.VarChar(100)
  defaultSubjectRole        String                      @map("default_subject_role") @db.VarChar(30)
  electiveGroup             String?                     @map("elective_group") @db.VarChar(40)
  creditHours               Decimal                     @default(0.00) @map("credit_hours") @db.Decimal(4, 2)
  fullMarks                 Decimal                     @default(100.00) @map("full_marks") @db.Decimal(6, 2)
  passEvaluationMode        String                      @default("SEPARATE_COMPONENTS") @map("pass_evaluation_mode") @db.VarChar(40)
  displayOrder              Int                         @default(1) @map("display_order")
  academicSubjects          AcademicSubjects            @relation(fields: [subjectId], references: [id], onUpdate: Restrict, map: "FK_6db9c01b5b77757cb51ec8963dd")
  examSubjectComponents     ExamSubjectComponents[]
  studentComponentMarks     StudentComponentMarks[]
  studentSubjectEnrollments StudentSubjectEnrollments[]
  studentSubjectResults     StudentSubjectResults[]

  @@index([subjectId], map: "FK_6db9c01b5b77757cb51ec8963dd")
  @@index([academicSessionId, classOrDeptId], map: "IDX_SYLLABUS_SESSION_CLASS")
  @@map("class_syllabus_subjects")
}

model CostCenters {
  id                     String                   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  centerCode             String                   @unique(map: "UQ_59074ee7f832613289d2c4ef60e") @map("center_code") @db.VarChar(15)
  centerName             String                   @map("center_name") @db.VarChar(100)
  institutionType        String                   @default("SCHOOL") @map("institution_type") @db.VarChar(20)
  parentId               String?                  @map("parent_id") @db.Char(36)
  isActive               Boolean                  @default(true) @map("is_active")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  adjunctHonorariumBills AdjunctHonorariumBills[]
  costCenters            CostCenters?             @relation("cost_centersTocost_centers", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_cost_centers_parent")
  otherCostCenters       CostCenters[]            @relation("cost_centersTocost_centers")
  feeHeads               FeeHeads[]
  journalLines           JournalLines[]
  payrollRuns            PayrollRuns[]
  studentInvoiceLines    StudentInvoiceLines[]
