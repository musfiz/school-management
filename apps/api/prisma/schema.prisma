}

model ExPrincipals {
  id        String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name      String   @db.VarChar(150)
  nameBn    String?  @map("name_bn") @db.VarChar(150)
  tenure    String?  @db.VarChar(150)
  imageUrl  String?  @map("image_url") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("ex_principals")
}

model ExamSubjectComponents {
  id                    String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  examTermId            String                  @map("exam_term_id") @db.Char(36)
  syllabusSubjectId     String                  @map("syllabus_subject_id") @db.Char(36)
  componentCode         String                  @map("component_code") @db.VarChar(30)
  componentName         String                  @map("component_name") @db.VarChar(60)
  sourceType            String                  @default("MANUAL_ENTRY") @map("source_type") @db.VarChar(30)
  sourceComponentCode   String?                 @map("source_component_code") @db.VarChar(30)
  maxRawMarks           Decimal                 @map("max_raw_marks") @db.Decimal(6, 2)
  conversionWeightPct   Decimal                 @default(100.00) @map("conversion_weight_pct") @db.Decimal(5, 2)
  convertedMaxMarks     Decimal                 @map("converted_max_marks") @db.Decimal(6, 2)
  minPassMarks          Decimal                 @default(0.00) @map("min_pass_marks") @db.Decimal(6, 2)
  displayOrder          Int                     @default(1) @map("display_order")
  classSyllabusSubjects ClassSyllabusSubjects   @relation(fields: [syllabusSubjectId], references: [id], onUpdate: Restrict, map: "FK_exam_components_syllabus")
  examTerms             ExamTerms               @relation(fields: [examTermId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_exam_components_term")
  studentComponentMarks StudentComponentMarks[]

  @@unique([examTermId, syllabusSubjectId, componentCode], map: "uq_exam_subject_components")
  @@index([examTermId, syllabusSubjectId], map: "IDX_EXAM_COMPONENTS_TERM_SUBJECT")
  @@index([syllabusSubjectId], map: "FK_exam_components_syllabus")
  @@map("exam_subject_components")
}

model ExamTermWeights {
  id               String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  parentExamTermId String    @map("parent_exam_term_id") @db.Char(36)
  childExamTermId  String    @map("child_exam_term_id") @db.Char(36)
  weightPct        Decimal   @map("weight_pct") @db.Decimal(5, 2)
  childExamTerm    ExamTerms @relation("exam_term_weights_child", fields: [childExamTermId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_term_weights_child")
  parentExamTerm   ExamTerms @relation("exam_term_weights_parent", fields: [parentExamTermId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_term_weights_parent")

  @@unique([parentExamTermId, childExamTermId], map: "uq_exam_term_weights")
  @@index([childExamTermId], map: "FK_term_weights_child")
  @@map("exam_term_weights")
}

model ExamTerms {
  id                         String                       @id @default(dbgenerated("(uuid())")) @db.Char(36)
  academicSessionId          String                       @map("academic_session_id") @db.Char(36)
  classOrDeptId              String                       @map("class_or_dept_id") @db.Char(36)
  gradingScaleId             String                       @map("grading_scale_id") @db.Char(36)
  termName                   String                       @map("term_name") @db.VarChar(100)
  termType                   String                       @map("term_type") @db.VarChar(30)
  parentTerminalExamId       String?                      @map("parent_terminal_exam_id") @db.Char(36)
  sequenceNo                 Int                          @default(1) @map("sequence_no")
  ctAggregationMode          String                       @default("BEST_N_AVERAGE") @map("ct_aggregation_mode") @db.VarChar(30)
  ctBestCount                Int                          @default(2) @map("ct_best_count")
  annualWeightPct            Decimal                      @default(100.00) @map("annual_weight_pct") @db.Decimal(5, 2)
  markRoundingMode           String                       @default("HALF_UP_INTEGER") @map("mark_rounding_mode") @db.VarChar(20)
  minCoursesToPromote        Int                          @default(0) @map("min_courses_to_promote")
  minCgpaToPromote           Decimal                      @default(0.00) @map("min_cgpa_to_promote") @db.Decimal(4, 2)
  status                     String                       @default("SETUP") @db.VarChar(20)
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                  DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  childTerms                 ExamTerms[]                  @relation("exam_terms_parent")
  examSubjectComponents      ExamSubjectComponents[]
  examTermWeightsChild       ExamTermWeights[]            @relation("exam_term_weights_child")
  examTermWeightsParent      ExamTermWeights[]            @relation("exam_term_weights_parent")
  gradingScales              GradingScales                @relation(fields: [gradingScaleId], references: [id], onUpdate: Restrict, map: "FK_exam_terms_scale")
  parentTerminalExam         ExamTerms?                   @relation("exam_terms_parent", fields: [parentTerminalExamId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_exam_terms_parent")
  resultGenerationJobs       ResultGenerationJobs[]
  studentAttendanceSummaries StudentAttendanceSummaries[]
  studentComponentMarks      StudentComponentMarks[]
  studentSubjectResults      StudentSubjectResults[]
  studentTermMarksheets      StudentTermMarksheets[]

  @@index([academicSessionId, classOrDeptId], map: "IDX_EXAM_TERMS_SESSION_CLASS")
  @@index([parentTerminalExamId], map: "FK_exam_terms_parent")
  @@index([status], map: "IDX_EXAM_TERMS_STATUS")
  @@map("exam_terms")
}

