# apps/api — environment example. Copy to `.env` and fill in real values.
# Application
PORT=3031
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=school

# JWT Configuration
JWT_SECRET=<replace-me-with-a-strong-random-secret>
JWT_EXPIRES_IN=7d

# Prisma ORM 6 reads the datasource URL straight from `schema.prisma`'s
# `env("DATABASE_URL")` -- there is no config file to derive it from the DB_*
# variables above, so these two are REQUIRED (the Prisma CLI auto-loads this
# .env file; the NestJS app itself still derives its own connection from DB_*
# via src/prisma/database-url.ts, so keep both in sync).
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/school

# Prisma Migrate shadow database, used by `prisma migrate diff` / `db:migrate:new`.
# The DB user needs CREATE DATABASE rights, or point this at a database that
# already exists.
SHADOW_DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/school_shadow

# ── Image storage strategy (modules/storage) ────────────────────────────
# 'local' (default) writes schools/<tenant>/<folder>/<uuid>.webp under
# ./uploads and serves it via the /uploads static mount. 's3' uploads the
# SAME key layout to AWS S3 or Cloudflare R2 — flipping this line is the
# entire migration; no code changes are ever involved.
STORAGE_DRIVER=local
# Local driver: storage root, resolved against apps/api working cwd.
# Must match the static mount in src/main.ts (which defaults to ./uploads).
UPLOADS_DIR=./uploads
# Local driver: absolute API origin used to build object URLs. Leave empty
# to return same-origin relative URLs ("/uploads/…") that the Next.js
# resolveImageUrl() helper resolves.
API_PUBLIC_URL=
# S3 / Cloudflare R2 driver (used only when STORAGE_DRIVER=s3)
# R2: region "auto", endpoint https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 public bucket host / CDN / custom domain serving objects read-only.
S3_PUBLIC_URL=

