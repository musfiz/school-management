{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:smoke": "tsx scripts/prisma-smoke.ts",
    "seed:results": "ts-node -T -r tsconfig-paths/register scripts/seed-academic-results.ts",
    "verify:results": "ts-node -T -r tsconfig-paths/register scripts/verify-result-engine.ts",
    "parity": "ts-node -T -r tsconfig-paths/register scripts/parity/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
