{
  "name": "school-management",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "prisma:generate": "pnpm --filter api run prisma:generate",
    "prisma:migrate": "pnpm --filter api run prisma:migrate",
    "prisma:db-seed": "pnpm --filter api run prisma:db-seed",
    "prisma:deploy": "pnpm --filter api run prisma:deploy",
    "prisma:status": "pnpm --filter api run prisma:status",
    "prisma:studio": "pnpm --filter api run prisma:studio",
    "prisma:pull": "pnpm --filter api run prisma:pull",
    "prisma:smoke": "pnpm --filter api run prisma:smoke",
    "seed:authorization": "pnpm --filter api seed:authorization",
    "seed:auth": "pnpm --filter api seed:auth",
    "ports:free": "node scripts/free-port.mjs"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "pnpm@11.23.0"
}
