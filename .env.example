# =============================================================================
# School Management Monorepo — Environment Variables (Example)
# Copy this file to `.env` in the root and to each app that needs it.
# Never commit real secrets. Use `.env.local` for personal overrides.
# =============================================================================

# -----------------------------------------------------------------------------
# Root / Shared
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# apps/api  (NestJS backend — http://localhost:3031)
# -----------------------------------------------------------------------------
API_PORT=3031
API_BASE_URL=http://localhost:3031
# CORS_ORIGIN=http://localhost:3000
# DATABASE_URL=postgres://user:password@localhost:5432/school_mgmt
# JWT_SECRET=replace-me-with-a-long-random-string
# JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# apps/web  (Next.js frontend — http://localhost:3030)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3031
NEXT_PUBLIC_SITE_NAME="School Management"
NEXT_PUBLIC_SITE_URL=http://localhost:3030
